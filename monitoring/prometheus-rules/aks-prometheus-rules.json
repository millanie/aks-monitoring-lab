{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Prometheus Alert Rules for AKS monitoring demo. Deployed as Azure Prometheus Rule Groups."
  },
  "parameters": {
    "azureMonitorWorkspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Azure Monitor Workspace (Managed Prometheus) resource ID"
      }
    },
    "clusterName": {
      "type": "string",
      "defaultValue": "aks-monitoring-demo"
    },
    "actionGroupId": {
      "type": "string",
      "metadata": {
        "description": "Action Group resource ID for alert notifications"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.AlertsManagement/prometheusRuleGroups",
      "apiVersion": "2023-03-01",
      "name": "aks-node-alerts",
      "location": "[parameters('location')]",
      "properties": {
        "description": "노드 수준 알림 규칙 (CPU, Memory, Disk, NotReady)",
        "scopes": ["[parameters('azureMonitorWorkspaceResourceId')]"],
        "clusterName": "[parameters('clusterName')]",
        "interval": "PT1M",
        "rules": [
          {
            "alert": "NodeCPUHighUtilization",
            "expression": "avg by (instance) (1 - rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) > 0.85",
            "for": "PT5M",
            "severity": 3,
            "labels": {
              "team": "platform",
              "category": "node"
            },
            "annotations": {
              "summary": "노드 CPU 사용률이 85%를 초과했습니다",
              "description": "노드 {{ $labels.instance }}의 CPU 사용률이 {{ $value | humanizePercentage }}입니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ],
            "resolveConfiguration": {
              "autoResolved": true,
              "timeToResolve": "PT10M"
            }
          },
          {
            "alert": "NodeMemoryHighUtilization",
            "expression": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) > 0.90",
            "for": "PT5M",
            "severity": 2,
            "labels": {
              "team": "platform",
              "category": "node"
            },
            "annotations": {
              "summary": "노드 메모리 사용률이 90%를 초과했습니다",
              "description": "노드 {{ $labels.instance }}의 메모리 사용률이 {{ $value | humanizePercentage }}입니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ],
            "resolveConfiguration": {
              "autoResolved": true,
              "timeToResolve": "PT10M"
            }
          },
          {
            "alert": "NodeDiskPressure",
            "expression": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) > 0.85",
            "for": "PT5M",
            "severity": 2,
            "labels": {
              "team": "platform",
              "category": "node"
            },
            "annotations": {
              "summary": "노드 디스크 사용률이 85%를 초과했습니다",
              "description": "노드 {{ $labels.instance }}의 {{ $labels.mountpoint }} 디스크 사용률이 {{ $value | humanizePercentage }}입니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "NodeNotReady",
            "expression": "kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0",
            "for": "PT2M",
            "severity": 1,
            "labels": {
              "team": "platform",
              "category": "node"
            },
            "annotations": {
              "summary": "노드가 NotReady 상태입니다",
              "description": "노드 {{ $labels.node }}가 2분 이상 NotReady 상태입니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.AlertsManagement/prometheusRuleGroups",
      "apiVersion": "2023-03-01",
      "name": "aks-pod-alerts",
      "location": "[parameters('location')]",
      "properties": {
        "description": "Pod 수준 알림 규칙 (CrashLoop, OOM, Pending, Restart)",
        "scopes": ["[parameters('azureMonitorWorkspaceResourceId')]"],
        "clusterName": "[parameters('clusterName')]",
        "interval": "PT1M",
        "rules": [
          {
            "alert": "PodCrashLoopBackOff",
            "expression": "increase(kube_pod_container_status_restarts_total[15m]) > 3",
            "for": "PT5M",
            "severity": 2,
            "labels": {
              "team": "app",
              "category": "pod"
            },
            "annotations": {
              "summary": "Pod가 CrashLoopBackOff 상태입니다",
              "description": "{{ $labels.namespace }}/{{ $labels.pod }}의 컨테이너 {{ $labels.container }}가 15분 내 3회 이상 재시작되었습니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "PodOOMKilled",
            "expression": "kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"} > 0",
            "for": "PT1M",
            "severity": 2,
            "labels": {
              "team": "app",
              "category": "pod"
            },
            "annotations": {
              "summary": "Pod가 OOMKilled 되었습니다",
              "description": "{{ $labels.namespace }}/{{ $labels.pod }}의 컨테이너 {{ $labels.container }}가 OOM으로 종료되었습니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "PodPendingTooLong",
            "expression": "kube_pod_status_phase{phase=\"Pending\"} == 1",
            "for": "PT10M",
            "severity": 3,
            "labels": {
              "team": "platform",
              "category": "pod"
            },
            "annotations": {
              "summary": "Pod가 10분 이상 Pending 상태입니다",
              "description": "{{ $labels.namespace }}/{{ $labels.pod }}가 10분 이상 Pending 상태입니다. 리소스 부족 또는 스케줄링 이슈를 확인하세요."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "ContainerCPUThrottled",
            "expression": "sum by (namespace, pod, container) (rate(container_cpu_cfs_throttled_seconds_total[5m])) / sum by (namespace, pod, container) (rate(container_cpu_cfs_periods_total[5m])) > 0.5",
            "for": "PT10M",
            "severity": 3,
            "labels": {
              "team": "app",
              "category": "pod"
            },
            "annotations": {
              "summary": "컨테이너 CPU가 50% 이상 throttle 되고 있습니다",
              "description": "{{ $labels.namespace }}/{{ $labels.pod }}/{{ $labels.container }}의 CPU throttle 비율이 {{ $value | humanizePercentage }}입니다. CPU limit 증가를 고려하세요."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.AlertsManagement/prometheusRuleGroups",
      "apiVersion": "2023-03-01",
      "name": "aks-app-alerts",
      "location": "[parameters('location')]",
      "properties": {
        "description": "애플리케이션 수준 알림 규칙 (HTTP 에러율, 레이턴시, 커스텀 비즈니스 메트릭)",
        "scopes": ["[parameters('azureMonitorWorkspaceResourceId')]"],
        "clusterName": "[parameters('clusterName')]",
        "interval": "PT1M",
        "rules": [
          {
            "alert": "HighHTTPErrorRate",
            "expression": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (namespace, pod) / sum(rate(http_requests_total[5m])) by (namespace, pod) > 0.05",
            "for": "PT5M",
            "severity": 2,
            "labels": {
              "team": "app",
              "category": "application"
            },
            "annotations": {
              "summary": "HTTP 5xx 에러율이 5%를 초과했습니다",
              "description": "{{ $labels.namespace }}/{{ $labels.pod }}의 5xx 에러율이 {{ $value | humanizePercentage }}입니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "HighRequestLatency",
            "expression": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, namespace, pod)) > 2",
            "for": "PT5M",
            "severity": 3,
            "labels": {
              "team": "app",
              "category": "application"
            },
            "annotations": {
              "summary": "P95 요청 레이턴시가 2초를 초과했습니다",
              "description": "{{ $labels.namespace }}/{{ $labels.pod }}의 P95 레이턴시가 {{ $value }}초입니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "HighOrderQueueDepth",
            "expression": "order_queue_depth > 30",
            "for": "PT5M",
            "severity": 3,
            "labels": {
              "team": "app",
              "category": "business"
            },
            "annotations": {
              "summary": "주문 큐 깊이가 30을 초과했습니다",
              "description": "현재 주문 큐 깊이: {{ $value }}. 처리 지연이 발생할 수 있습니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          },
          {
            "alert": "OrderFailureRateHigh",
            "expression": "sum(rate(orders_processed_total{status=\"failed\"}[5m])) / sum(rate(orders_processed_total[5m])) > 0.1",
            "for": "PT5M",
            "severity": 2,
            "labels": {
              "team": "app",
              "category": "business"
            },
            "annotations": {
              "summary": "주문 실패율이 10%를 초과했습니다",
              "description": "주문 실패율이 {{ $value | humanizePercentage }}입니다. 즉각적인 조치가 필요합니다."
            },
            "actions": [
              {
                "actionGroupId": "[parameters('actionGroupId')]"
              }
            ]
          }
        ]
      }
    }
  ]
}
